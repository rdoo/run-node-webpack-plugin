  "description": "Webpack plugin that starts a node.js script after webpack compilation and smartly restarts it after subsequent recompilations",
  "author": "rdoo",
  "license": "MIT",
  "main": "dist/cjs.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "run",
    "start",
    "restart",
    "node",
    "nodejs",
    "script",
    "server",
    "webpack",
    "plugin"
  ],
  "homepage": "https://github.com/rdoo/run-node-webpack-plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/rdoo/run-node-webpack-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/rdoo/run-node-webpack-plugin/issues"
  },
  "scripts": {
    "build": "tsc",
    "prebuild": "rimraf dist",
    "test": "mocha -r ts-node/register test/**/*.test.ts"
  },
  "devDependencies": {
    "@types/chai": "5.2.2",
    "@types/mocha": "10.0.10",
    "@types/node": "24.5.2",
    "@types/sinon": "17.0.4",
    "chai": "6.2.0",
    "mocha": "11.7.2",
    "rimraf": "6.0.1",
    "sinon": "21.0.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.2",
    "webpack": "5.101.3"
  },
  "peerDependencies": {
    "webpack": "^4.0.0 || ^5.0.0"
  }
}
